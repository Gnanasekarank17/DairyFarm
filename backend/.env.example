PORT=3000
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google Service Account (for Sheets & Drive)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Google Sheets
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=30d

# Admin PIN (hashed)
ADMIN_PIN=1234
STAFF_PIN=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your@gmail.com

# SMS OTP (Fast2SMS) — API key from dashboard -> Dev API (not a phone number)
FAST2SMS_API_KEY=your_fast2sms_api_key

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_API_VERSION=v20.0

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=your_expo_access_token

# Business Info
BUSINESS_NAME="Sri Krishna Dairy Farm"
BUSINESS_ADDRESS="123 Farm Road, Chennai"
BUSINESS_PHONE=9999999999
BUSINESS_GST=22AAAAA0000A1Z5
